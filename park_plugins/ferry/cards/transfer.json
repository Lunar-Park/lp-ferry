      "unit": "bytes",
      "note": "current_file",
      "rate": "rate",
      "eta": "eta_s",
      "actions": [
        "open"
      ]
    },
    "done": {
      "type": "receipt",
      "title": "Landed and verified",
      "files": "files",
      "bytes": "bytes",
      "algorithm": "checksum_algo",
      "verified": "verified",
      "state": "verified",
      "actions": [
        "open"
      ]
    },
    "failed": {
      "type": "status",
      "title": "Did not finish",
      "items": [
        {
          "label": "What went wrong",
          "value": "error"
        },
        {
          "label": "File in flight",
          "value": "current_file"
        }
      ],
      "actions": [
        "retry",
        "open"
      ]
