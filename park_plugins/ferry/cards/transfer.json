{
  "states": {
    "waiting_clearance": {
      "type": "tree",
      "title": "Waiting for a person",
      "label": "What will move",
      "nodes": [
        {
          "id": "source",
          "label": "Source",
          "note": "the folder on the machine that holds it"
        },
        {
          "id": "destination",
          "label": "Destination",
          "note": "where the files land, verified"
        },
        {
          "id": "receipt",
          "label": "Receipt",
          "note": "every file hashed as it lands"
        }
      ],
      "edges": [
