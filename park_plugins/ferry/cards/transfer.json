{
  "states": {
    "waiting_clearance": {
      "type": "flow",
      "title": "Waiting for a person",
      "nodes": [
        {
          "id": "source",
          "label": "Source",
          "note": {
            "$path": "$.params.source",
            "fallback": "the folder on the machine that holds it"
          }
        },
        {
          "id": "destination",
          "label": "Destination",
          "note": {
            "$path": "$.params.destination",
            "fallback": "where the files land, verified"
          }
        },
        {
          "id": "receipt",
          "label": "Receipt",
          "note": "every file hashed as it lands"
        }
      ],
      "edges": [
        [
          "source",
          "destination"
        ],
        [
          "destination",
          "receipt"
        ]
      ],
      "focus": "destination",
      "actions": [
        "approve",
        "decline"
      ]
    },
    "running": {
      "type": "progress",
      "title": "Copying",
      "label": "Verified bytes",
      "done": {
        "$path": "$.progress.detail.bytes_verified",
        "fallback": {
          "$path": "$.progress.fraction",
          "fallback": 0
        }
      },
      "total": {
        "$path": "$.progress.detail.bytes_total",
        "fallback": 1
      },
      "note": {
        "$path": "$.progress.detail.current_file",
        "fallback": {
          "$path": "$.progress.note",
          "fallback": "Copying"
        }
      },
      "actions": [
        "open"
      ]
    },
    "done": {
      "type": "receipt",
      "title": "Landed and verified",
      "status": "ok",
      "rows": [
        {
          "label": "Files",
          "value": {
            "$path": "$.result.files",
            "fallback": "\u2014"
          },
          "evidence": "verified"
        },
        {
          "label": "Bytes",
          "value": {
            "$path": "$.result.bytes",
            "fallback": "\u2014"
          },
          "evidence": "verified"
        },
        {
          "label": "Checksum",
          "value": {
            "$path": "$.result.checksum_algo",
            "fallback": "xxh64"
          },
          "evidence": "verified"
        },
        {
          "label": "Verified",
          "value": {
            "$path": "$.result.verified",
            "fallback": "ok"
          },
          "evidence": "verified"
        }
      ],
      "actions": [
        "open"
      ]
    },
    "failed": {
      "type": "status",
      "title": "Did not finish",
      "items": [
        {
          "label": "Transfer failed",
          "state": "bad",
          "note": {
            "$path": "$.error",
            "fallback": "Unknown error"
          }
        },
        {
          "label": "File in flight",
          "state": "warn",
          "note": {
            "$path": "$.progress.detail.current_file",
            "fallback": "\u2014"
          }
        }
      ],
      "actions": [
        "retry",
        "open"
      ]
    }
  }
}
